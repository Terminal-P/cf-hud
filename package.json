{
  "name": "cf-hud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cross-platform floating HUD for Codeforces contests: live rank, score, problems and rating prediction.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cf-hud/cf-hud"
  },
  "keywords": [
    "codeforces",
    "rating",
    "overlay",
    "hud",
    "tauri",
    "competitive-programming"
  ],
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "tsx scripts/calibrate.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
